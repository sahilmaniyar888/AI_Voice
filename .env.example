# --- Mode -----------------------------------------------------------------
# 1 = fake calls (free, for UI work and backup demo). 0 = real Bolna calls.
SIMULATE=1

# --- Bolna (needed when SIMULATE=0) ----------------------------------------
BOLNA_API_KEY=
BOLNA_DISPATCHER_AGENT_ID=
# Optional (P2): agent that calls the broker back with the top 3 options
BOLNA_CALLBACK_AGENT_ID=
# Optional (P2): agent that tells the chosen truck owner they got the load
BOLNA_CONFIRM_AGENT_ID=
# Optional caller ID: a number bought in your Bolna account (E.164). Empty = Bolna default number.
BOLNA_FROM_NUMBER=

# --- Your server ------------------------------------------------------------
# Your tunnel URL, e.g. https://abc-def.trycloudflare.com (shown in logs; used in Bolna tool URLs)
PUBLIC_BASE_URL=http://localhost:8000
# Any random string. Append ?secret=<this> to every Bolna tool URL.
TOOL_SECRET=change-me-to-something-random

# --- Broker (the demo broker is you) ---------------------------------------
BROKER_NAME=Sharma Roadlines
# Your mobile in E.164. The callback with the best options goes here.
BROKER_PHONE=

# --- Tuning ---------------------------------------------------------------
MAX_PARALLEL_CALLS=10
SHORTLIST_TIMEOUT_SECONDS=180
AUTO_CALLBACK=1
ETA_RUPEES_PER_HOUR=500
MANUAL_MINUTES_PER_CALL=3
